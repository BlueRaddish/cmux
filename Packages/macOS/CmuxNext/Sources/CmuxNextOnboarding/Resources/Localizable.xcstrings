    "onboarding.accounts.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux found these sign-ins on this Mac. Nothing is uploaded unless you choose Connect."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "عثر cmux على تسجيلات الدخول هذه على هذا الـ Mac. لن يتم رفع أي شيء ما لم تختر \"اتصال\"."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux je pronašao ove prijave na ovom Macu. Ništa se ne otprema osim ako ne odaberete Poveži."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux fandt disse logins på denne Mac. Intet uploades, medmindre du vælger Forbind."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux hat diese Anmeldungen auf diesem Mac gefunden. Es wird nichts hochgeladen, außer du wählst „Verbinden“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux encontró estos inicios de sesión en este Mac. No se sube nada a menos que elijas Conectar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux a trouvé ces connexions sur ce Mac. Rien n’est envoyé sauf si vous choisissez Connecter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux ha trovato questi accessi su questo Mac. Non viene caricato nulla a meno che tu non scelga Collega."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux はこの Mac 上で次のサインイン情報を見つけました。「接続」を選択しない限り、何もアップロードされません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux បានរកឃើញការចូលគណនីទាំងនេះនៅលើ Mac នេះ។ គ្មានអ្វីត្រូវបានផ្ទុកឡើងទេ លុះត្រាតែអ្នកជ្រើសរើស ភ្ជាប់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux가 이 Mac에서 다음 로그인 정보를 찾았습니다. 연결을 선택하지 않으면 아무것도 업로드되지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux fant disse påloggingene på denne Macen. Ingenting lastes opp med mindre du velger Koble til."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux znalazł te logowania na tym Macu. Nic nie jest wysyłane, chyba że wybierzesz Połącz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O cmux encontrou estes logins neste Mac. Nada é enviado a menos que você escolha Conectar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux нашел эти входы в аккаунты на этом Mac. Ничего не загружается, пока Вы не выберете «Подключить»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux พบข้อมูลการลงชื่อเข้าเหล่านี้บน Mac เครื่องนี้ จะไม่มีการอัปโหลดใดๆ เว้นแต่คุณเลือก เชื่อมต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux bu Mac’te şu oturum açma bilgilerini buldu. Bağlan’ı seçmediğiniz sürece hiçbir şey yüklenmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux знайшов ці входи на цьому Mac. Нічого не вивантажується, доки ви не виберете «Під’єднати»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux đã tìm thấy các thông tin đăng nhập này trên máy Mac. Không có gì được tải lên trừ khi bạn chọn Kết nối."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux 在这台 Mac 上找到了以下登录信息。除非你选择“连接”，否则不会上传任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux 在這部 Mac 上找到以下登入資訊。除非你選擇「連接」，否則不會上傳任何內容。"
          }
        }
      }
    },
