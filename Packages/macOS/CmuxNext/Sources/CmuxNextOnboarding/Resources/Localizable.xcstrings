    "onboarding.import.fda.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS protects Safari's bookmarks and history. Turn on cmux in Full Disk Access, then check again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS は Safari のブックマークと履歴を保護しています。「フルディスクアクセス」で cmux をオンにしてから、再度確認してください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يحمي macOS الإشارات المرجعية والسجل في Safari. شغّل cmux في الوصول الكامل إلى القرص، ثم تحقق مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS štiti Safarijeve oznake i historiju. Uključite cmux u Potpunom pristupu disku, a zatim provjerite ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS beskytter Safaris bogmærker og historik. Slå cmux til under Fuld diskadgang, og tjek så igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS schützt die Lesezeichen und den Verlauf von Safari. Aktiviere cmux unter „Festplattenvollzugriff“ und prüfe dann erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS protege los marcadores y el historial de Safari. Activa cmux en Acceso total al disco y vuelve a comprobarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS protège les signets et l’historique de Safari. Activez cmux dans Accès complet au disque, puis vérifiez à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS protegge i preferiti e la cronologia di Safari. Attiva cmux in Accesso completo al disco, poi verifica di nuovo."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS ការពារចំណាំ និងប្រវត្តិរបស់ Safari។ បើក cmux ក្នុងសិទ្ធិចូលប្រើថាសពេញលេញ រួចពិនិត្យម្ដងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS는 Safari의 책갈피와 방문 기록을 보호합니다. 전체 디스크 접근 권한에서 cmux를 켠 다음 다시 확인하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS beskytter bokmerkene og loggen i Safari. Slå på cmux under Full disktilgang, og sjekk på nytt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS chroni zakładki i historię Safari. Włącz cmux w sekcji Pełny dostęp do dysku, a następnie sprawdź ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O macOS protege os favoritos e o histórico do Safari. Ative o cmux em Acesso Total ao Disco e verifique novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS защищает закладки и историю Safari. Включите cmux в разделе «Полный доступ к диску», затем проверьте снова."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS ปกป้องบุ๊คมาร์คและประวัติของ Safari เปิด cmux ในการเข้าถึงดิสก์เต็มรูปแบบ แล้วตรวจสอบอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS, Safari'nin yer işaretlerini ve geçmişini korur. Tam Disk Erişimi'nde cmux'ı açın, ardından yeniden denetleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS захищає закладки й історію Safari. Увімкніть cmux у розділі «Повний доступ до диска», потім перевірте знову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS bảo vệ dấu trang và lịch sử của Safari. Hãy bật cmux trong Truy cập toàn bộ ổ đĩa, rồi kiểm tra lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS 会保护 Safari 的书签和历史记录。请在“完全磁盘访问权限”中开启 cmux，然后再次检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS 會保護 Safari 的書籤和瀏覽記錄。請在「完整磁碟取用權限」中開啟 cmux，然後再次檢查。"
          }
        }
      }
    },
