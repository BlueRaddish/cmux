    "onboarding.workflow.quitNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminals run in cmux-tui, so agents can keep working after cmux quits."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تعمل الوحدات الطرفية في cmux-tui، لذا يمكن للوكلاء مواصلة العمل بعد إنهاء cmux."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Terminali rade u cmux-tui, pa agenti mogu nastaviti raditi nakon što se cmux zatvori."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Terminaler kører i cmux-tui, så agenter kan arbejde videre, efter cmux er afsluttet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Terminals laufen in cmux-tui, damit Agents weiterarbeiten können, nachdem cmux beendet wurde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los terminales se ejecutan en cmux-tui, así que los agentes pueden seguir trabajando después de salir de cmux."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les terminaux s’exécutent dans cmux-tui, les agents peuvent donc continuer après la fermeture de cmux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I terminali vengono eseguiti in cmux-tui, così gli agenti possono continuare a lavorare dopo l’uscita da cmux."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ターミナルは cmux-tui で実行されるため、cmux を終了してもエージェントは作業を続けられます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ស្ថានីយដំណើរការក្នុង cmux-tui ដូច្នេះភ្នាក់ងារអាចបន្តធ្វើការបន្ទាប់ពី cmux ចាកចេញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "터미널은 cmux-tui에서 실행되므로 cmux를 종료한 후에도 에이전트가 계속 작업할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Terminaler kjører i cmux-tui, så agenter kan jobbe videre etter at cmux avsluttes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Terminale działają w cmux-tui, więc agenci mogą pracować dalej po zamknięciu cmux."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os terminais rodam no cmux-tui, então os agentes podem continuar trabalhando depois que o cmux é encerrado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Терминалы работают в cmux-tui, поэтому агенты могут продолжать работу после завершения cmux."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เทอร์มินัลทำงานใน cmux-tui เอเจนต์จึงทำงานต่อได้หลังจาก cmux ออก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Terminaller cmux-tui’de çalışır, böylece ajanlar cmux kapandıktan sonra da çalışmaya devam edebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Термінали працюють у cmux-tui, тому агенти можуть працювати й після виходу з cmux."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Terminal chạy trong cmux-tui, nên tác tử có thể tiếp tục làm việc sau khi thoát cmux."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "终端在 cmux-tui 中运行，因此 cmux 退出后智能体仍可继续工作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "終端機在 cmux-tui 中執行，因此 cmux 結束後代理程式仍可繼續工作。"
          }
        }
      }
    },
    "onboarding.workflow.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When agents need you, and what happens to terminals when you quit."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "متى يحتاجك الوكلاء، وماذا يحدث للوحدات الطرفية عند الإنهاء."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kada vas agenti trebaju i šta se dešava s terminalima kada izađete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hvornår agenter har brug for dig, og hvad der sker med terminaler, når du afslutter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wann Agents dich brauchen und was mit Terminals beim Beenden passiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cuándo te necesitan los agentes y qué pasa con los terminales al salir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quand les agents ont besoin de vous, et ce qu’il advient des terminaux quand vous quittez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quando gli agenti hanno bisogno di te e cosa succede ai terminali quando esci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "エージェントから通知を受けるタイミングと、終了時のターミナルの扱いを設定します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ពេលភ្នាក់ងារត្រូវការអ្នក និងអ្វីដែលកើតឡើងចំពោះស្ថានីយពេលអ្នកចាកចេញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "에이전트가 사용자를 필요로 할 때와 종료 시 터미널 처리 방식을 설정합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Når agenter trenger deg, og hva som skjer med terminaler når du avslutter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kiedy agenci Cię potrzebują i co dzieje się z terminalami po zamknięciu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quando os agentes precisam de você e o que acontece com os terminais ao encerrar."
          }
        },
