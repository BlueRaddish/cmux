    "onboarding.import.cookies.denied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Keychain access denied, sign-ins skipped."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@: تم رفض الوصول إلى Keychain، وتم تخطي تسجيلات الدخول."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@: pristup za Keychain odbijen, prijave preskočene."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@: Adgang til Keychain afvist, logins sprunget over."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@: Zugriff auf Keychain verweigert, Anmeldungen übersprungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@: acceso al Keychain denegado, inicios de sesión omitidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ : accès au Keychain refusé, connexions ignorées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@: accesso a Keychain negato, accessi saltati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@: Keychain へのアクセスが拒否されたため、サインイン情報をスキップしました。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@: ការចូលប្រើ Keychain ត្រូវបានបដិសេធ ការចូលគណនីត្រូវបានរំលង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@: Keychain 접근이 거부되어 로그인 정보를 건너뛰었습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@: Tilgang til Keychain avslått, pålogginger hoppet over."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@: odmowa dostępu do Keychain, logowania pominięte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@: acesso ao Keychain negado, logins ignorados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@: доступ к Keychain запрещен, входы пропущены."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@: การเข้าถึง Keychain ถูกปฏิเสธ ข้ามการลงชื่อเข้าแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@: Keychain erişimi reddedildi, oturum açma bilgileri atlandı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@: доступ до Keychain заборонено, входи пропущено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@: Truy cập Keychain bị từ chối, đã bỏ qua thông tin đăng nhập."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@：Keychain 访问被拒绝，已跳过登录信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@：Keychain 取用遭拒，已略過登入資訊。"
          }
        }
      }
    },
