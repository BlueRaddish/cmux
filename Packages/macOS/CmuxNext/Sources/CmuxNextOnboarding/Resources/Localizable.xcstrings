    "onboarding.keyboard.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change any shortcut later: highlight an action in the command palette and press ⌘K."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "غيّر أي اختصار لاحقًا: حدد إجراءً في لوحة الأوامر واضغط على ⌘K."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bilo koju prečicu promijenite kasnije: označite radnju u paleti komandi i pritisnite ⌘K."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skift enhver genvej senere: Fremhæv en handling i kommandopaletten, og tryk på ⌘K."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jeden Kurzbefehl kannst du später ändern: Markiere eine Aktion in der Befehlspalette und drücke ⌘K."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cambia cualquier atajo más tarde: resalta una acción en la paleta de comandos y pulsa ⌘K."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Modifiez n’importe quel raccourci plus tard : sélectionnez une action dans la palette de commandes et appuyez sur ⌘K."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cambia qualsiasi scorciatoia in seguito: evidenzia un’azione nella palette dei comandi e premi ⌘K."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ショートカットは後からいつでも変更できます。コマンドパレットでアクションをハイライトして ⌘K を押してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ផ្លាស់ប្ដូរផ្លូវកាត់ណាមួយនៅពេលក្រោយ៖ បន្លិចសកម្មភាពមួយក្នុងផ្ទាំងពាក្យបញ្ជា ហើយចុច ⌘K។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "단축키는 나중에 언제든지 변경할 수 있습니다. 명령 팔레트에서 동작을 하이라이트하고 ⌘K를 누르십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Endre hvilken som helst snarvei senere: Marker en handling i kommandopaletten og trykk på ⌘K."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Każdy skrót możesz zmienić później: zaznacz czynność w palecie poleceń i naciśnij ⌘K."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Altere qualquer atalho depois: destaque uma ação na paleta de comandos e pressione ⌘K."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Любое сочетание клавиш можно изменить позже: выделите действие в палитре команд и нажмите ⌘K."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เปลี่ยนปุ่มลัดใดก็ได้ภายหลัง: ไฮไลท์การทำงานในชุดคำสั่ง แล้วกด ⌘K"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kestirmeleri daha sonra değiştirebilirsiniz: Komut paletinde bir eylemi vurgulayıp ⌘K’ye basın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Будь-яке скорочення можна змінити пізніше: виділіть дію в палітрі команд і натисніть ⌘K."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Thay đổi phím tắt bất cứ lúc nào: tô sáng một tác vụ trong bảng lệnh và nhấn ⌘K."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "以后可随时更改快捷键：在命令面板中高亮某个操作，然后按 ⌘K。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "之後可隨時更改快速鍵：在命令面板中反白某個動作，然後按 ⌘K。"
          }
        }
      }
    },
