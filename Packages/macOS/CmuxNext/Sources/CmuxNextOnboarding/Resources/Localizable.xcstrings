    "onboarding.import.cookies.undecryptable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ encrypts sign-ins in a way cmux cannot read."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يشفّر %@ تسجيلات الدخول بطريقة لا يستطيع cmux قراءتها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ šifrira prijave na način koji cmux ne može pročitati."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ krypterer logins på en måde, som cmux ikke kan læse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ verschlüsselt Anmeldungen auf eine Weise, die cmux nicht lesen kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ cifra los inicios de sesión de una forma que cmux no puede leer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ chiffre les connexions d’une manière que cmux ne peut pas lire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ cifra gli accessi in un modo che cmux non può leggere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ は cmux が読み取れない方式でサインイン情報を暗号化しています。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ អ៊ិនគ្រីបការចូលគណនីតាមរបៀបដែល cmux មិនអាចអានបាន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@은(는) cmux가 읽을 수 없는 방식으로 로그인 정보를 암호화합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ krypterer pålogginger på en måte cmux ikke kan lese."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ szyfruje logowania w sposób, którego cmux nie może odczytać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ criptografa os logins de um jeito que o cmux não consegue ler."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ шифрует входы способом, который cmux не может прочитать."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ เข้ารหัสการลงชื่อเข้าในแบบที่ cmux อ่านไม่ได้"
