    "onboarding.keyboard.preset.vim.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Control-Command with H J K L to move, V and X to split."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Control-Command مع H J K L للتنقل، و V و X للتقسيم."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Control-Command s H J K L za kretanje, V i X za dijeljenje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Control-Kommando med H J K L til at flytte, V og X til at opdele."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Control-Befehl mit H J K L zum Bewegen, V und X zum Teilen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Control-Comando con H J K L para moverse, V y X para dividir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Contrôle-Commande avec H J K L pour se déplacer, V et X pour diviser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Control-Comando con H J K L per spostarsi, V e X per dividere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Control-Command と H J K L で移動、V と X で分割。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Control-Command ជាមួយ H J K L ដើម្បីផ្លាស់ទី V និង X ដើម្បីបំបែក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Control-Command와 H J K L로 이동, V 및 X로 분할."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Control-Kommando med H J K L for å flytte, V og X for å dele."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Control-Command z H J K L do ruchu, V i X do podziału."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Control-Command com H J K L para mover, V e X para dividir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Control-Command с H J K L для перемещения, V и X для разделения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Control-Command กับ H J K L เพื่อย้าย V และ X เพื่อแยก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hareket için H J K L, bölmek için V ve X ile Control-Command."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
