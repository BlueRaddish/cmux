            "value": "필요할 때 사용하는 화면"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skjermer, når du vil ha dem"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ekrany, gdy ich potrzebujesz"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Telas, quando você quiser"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Экраны, когда они нужны"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "หน้าจอ เมื่อคุณต้องการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "İstediğinizde ekranlar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Екрани, коли вони потрібні"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Màn hình, khi bạn cần"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "按需使用屏幕"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "需要時再使用畫面"
          }
        }
      }
    },
    "onboarding.tour.palette.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every action, setting and tab is one search away."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "すべてのアクション、設定、タブを検索ひとつで呼び出せます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "كل إجراء وإعداد وعلامة تبويب على بُعد بحث واحد."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Svaka radnja, postavka i kartica udaljena je jednu pretragu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alle handlinger, indstillinger og faner er én søgning væk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jede Aktion, jede Einstellung und jeder Tab ist nur eine Suche entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cada acción, ajuste y pestaña está a una búsqueda de distancia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chaque action, réglage et onglet est à une recherche près."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ogni azione, impostazione e scheda è a una ricerca di distanza."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "រាល់សកម្មភាព ការកំណត់ និងផ្ទាំង គឺនៅចម្ងាយតែការស្វែងរកមួយដង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "모든 동작, 설정, 탭을 한 번의 검색으로 찾을 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alle handlinger, innstillinger og faner er ett søk unna."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Każda czynność, ustawienie i karta są o jedno wyszukiwanie stąd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cada ação, ajuste e aba está a uma busca de distância."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Любое действие, настройка и вкладка — в одном поиске."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ทุกการทำงาน การตั้งค่า และแถบ อยู่ห่างเพียงการค้นหาครั้งเดียว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Her eylem, ayar ve sekme tek bir aramayla bulunur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Кожна дія, параметр і вкладка — за один пошук."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mọi thao tác, cài đặt và tab chỉ cách một lần tìm kiếm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "每个操作、设置和标签页都只需一次搜索。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "每個動作、設定和標籤頁都只需一次搜尋。"
          }
        }
      }
    },
    "onboarding.tour.keyTiers.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus and window keys work even inside a web page or a full-screen terminal app. Other keys go to what you type in."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "フォーカスとウインドウのキーは、Web ページやフルスクリーンのターミナルアプリ内でも機能します。その他のキーは入力中の対象に送られます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تعمل مفاتيح التركيز والنوافذ حتى داخل صفحة ويب أو تطبيق طرفية بملء الشاشة. تذهب المفاتيح الأخرى إلى حيث تكتب."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tipke za fokus i prozore rade čak i unutar web stranice ili terminalske aplikacije preko cijelog ekrana. Ostale tipke idu tamo gdje kucate."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fokus- og vinduestaster virker selv inde på en webside eller i en terminalapp i fuld skærm. Andre taster går til det, du skriver i."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fokus- und Fenstertasten funktionieren auch in einer Webseite oder einer Terminal-App im Vollbild. Andere Tasten gehen an das, worin du tippst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las teclas de foco y de ventana funcionan incluso dentro de una página web o una app de terminal a pantalla completa. Las demás teclas van a donde escribes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les touches de focus et de fenêtre fonctionnent même dans une page web ou une app de terminal en plein écran. Les autres touches vont là où vous tapez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I tasti di focus e di finestra funzionano anche dentro una pagina web o un'app da terminale a tutto schermo. Gli altri tasti vanno dove stai scrivendo."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "គ្រាប់ចុចផ្ដោត និងវិនដូ ដំណើរការសូម្បីតែនៅក្នុងទំព័រវិប ឬកម្មវិធីទែមីណាល់ពេញអេក្រង់។ គ្រាប់ចុចផ្សេងទៀតទៅកាន់កន្លែងដែលអ្នកកំពុងវាយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "포커스 및 윈도우 키는 웹 페이지나 전체 화면 터미널 앱 안에서도 작동합니다. 다른 키는 입력 중인 곳으로 전달됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fokus- og vindustaster virker selv inne på en nettside eller i en terminalapp i fullskjerm. Andre taster går til det du skriver i."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Klawisze fokusu i okien działają nawet na stronie internetowej lub w pełnoekranowej aplikacji terminalowej. Pozostałe klawisze trafiają tam, gdzie piszesz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As teclas de foco e de janela funcionam até dentro de uma página web ou de um app de terminal em tela cheia. As outras teclas vão para onde você está digitando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Клавиши фокуса и окон работают даже внутри веб-страницы или полноэкранного терминального приложения. Остальные клавиши идут туда, где вы печатаете."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ปุ่มโฟกัสและหน้าต่างทำงานได้แม้อยู่ในหน้าเว็บหรือแอปเทอร์มินัลแบบเต็มหน้าจอ ปุ่มอื่นจะส่งไปยังที่ที่คุณกำลังพิมพ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odak ve pencere tuşları bir web sayfasında veya tam ekran bir terminal uygulamasında bile çalışır. Diğer tuşlar yazdığınız yere gider."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Клавіші фокуса й вікон працюють навіть усередині вебсторінки або повноекранної термінальної програми. Інші клавіші йдуть туди, де ви друкуєте."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Các phím tiêu điểm và cửa sổ hoạt động cả trong trang web hoặc ứng dụng terminal toàn màn hình. Các phím khác được gửi đến nơi bạn đang nhập."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "焦点和窗口按键即使在网页或全屏终端 App 中也有效。其他按键会发送到你正在输入的地方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "焦點和視窗按鍵即使在網頁或全螢幕終端機 App 中也有效。其他按鍵會傳送到你正在輸入的地方。"
          }
        }
      }
    },
    "onboarding.tour.rooms.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch between sets of workspaces, each with its own theme. The dots at the bottom of the sidebar are your rooms."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ワークスペースのセットを切り替えます。各セットには独自のテーマがあります。サイドバー下部のドットがルームです。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "بدّل بين مجموعات مساحات العمل، لكل منها سمتها الخاصة. النقاط أسفل الشريط الجانبي هي غرفك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prebacujte se između skupova radnih prostora, svaki sa svojom temom. Tačke na dnu bočne trake su vaše sobe."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skift mellem sæt af arbejdsområder, hver med sit eget tema. Prikkerne nederst i indholdsoversigten er dine rum."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wechsle zwischen Gruppen von Workspaces, jede mit eigenem Theme. Die Punkte unten in der Seitenleiste sind deine Räume."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cambia entre conjuntos de espacios de trabajo, cada uno con su propio tema. Los puntos de la parte inferior de la barra lateral son tus salas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Passez d’un ensemble d’espaces de travail à l’autre, chacun avec son propre thème. Les points en bas de la barre latérale sont vos salles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Passa da un gruppo di spazi di lavoro all'altro, ognuno con il proprio tema. I punti in fondo alla barra laterale sono le tue stanze."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ប្ដូររវាងសំណុំកន្លែងធ្វើការ ដែលនីមួយៗមានរចនាប័ទ្មផ្ទាល់ខ្លួន។ ចំណុចនៅខាងក្រោមរបារចំហៀង គឺជាបន្ទប់របស់អ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "각각 고유한 테마가 있는 작업 공간 세트 간에 전환합니다. 사이드바 하단의 점이 룸입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bytt mellom sett med arbeidsområder, hvert med sitt eget tema. Prikkene nederst i sidepanelet er rommene dine."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przełączaj się między zestawami obszarów roboczych, każdy z własnym motywem. Kropki na dole paska bocznego to Twoje pokoje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alterne entre conjuntos de espaços de trabalho, cada um com seu próprio tema. Os pontos na parte inferior da barra lateral são as suas salas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Переключайтесь между наборами рабочих пространств, у каждого своя тема. Точки внизу боковой панели — это ваши комнаты."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "สลับระหว่างชุดพื้นที่ทำงาน แต่ละชุดมีธีมของตัวเอง จุดที่ด้านล่างของแถบด้านข้างคือห้องของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Her biri kendi temasına sahip çalışma alanı grupları arasında geçiş yapın. Kenar çubuğunun altındaki noktalar odalarınızdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Перемикайтеся між наборами робочих просторів, кожен зі своєю темою. Крапки внизу бічної панелі — це ваші кімнати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chuyển đổi giữa các bộ không gian làm việc, mỗi bộ có chủ đề riêng. Các chấm ở cuối thanh bên là các phòng của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在多组工作区之间切换，每组都有自己的主题。边栏底部的圆点就是你的房间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在多組工作區之間切換，每組都有自己的主題。側邊欄底部的圓點就是你的房間。"
          }
        }
      }
    },
    "onboarding.tour.splits.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Split any pane, or scroll through columns sideways. Drag a tab anywhere to move it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "任意のパネルを分割したり、列を横にスクロールしたりできます。タブはどこにでもドラッグして移動できます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "قسّم أي جزء، أو مرّر عبر الأعمدة أفقيًا. اسحب علامة تبويب إلى أي مكان لنقلها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Podijelite bilo koje okno ili listajte kroz kolone u stranu. Prevucite karticu bilo gdje da je premjestite."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Opdel enhver rude, eller rul sidelæns gennem kolonner. Træk en fane hvor som helst hen for at flytte den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Teile jeden Bereich oder scrolle seitlich durch Spalten. Ziehe einen Tab an eine beliebige Stelle, um ihn zu verschieben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Divide cualquier panel o desplázate lateralmente por las columnas. Arrastra una pestaña a cualquier lugar para moverla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Divisez n’importe quel volet ou faites défiler les colonnes latéralement. Faites glisser un onglet n’importe où pour le déplacer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dividi qualsiasi riquadro o scorri le colonne lateralmente. Trascina una scheda ovunque per spostarlo."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បំបែកផ្ទាំងណាមួយ ឬរំកិលកាត់ជួរឈរទៅចំហៀង។ អូសផ្ទាំងទៅកន្លែងណាក៏បាន ដើម្បីផ្លាស់ទីវា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "아무 패인이나 분할하거나 열을 가로로 스크롤하십시오. 탭을 아무 곳으로나 드래그하여 이동할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Del en hvilken som helst rute, eller rull sidelengs gjennom kolonner. Dra en fane hvor som helst for å flytte den."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Podziel dowolny panel lub przewijaj kolumny w bok. Przeciągnij kartę w dowolne miejsce, aby ją przenieść."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Divida qualquer painel ou role pelas colunas lateralmente. Arraste uma aba para qualquer lugar para movê-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Разделяйте любую панель или прокручивайте колонки вбок. Перетащите вкладку куда угодно, чтобы переместить ее."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แบ่งบานหน้าต่างใดก็ได้ หรือเลื่อนผ่านคอลัมน์ไปทางด้านข้าง ลากแถบไปที่ใดก็ได้เพื่อย้าย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Herhangi bir bölmeyi ayırın veya sütunlar arasında yana kaydırın. Taşımak için bir sekmeyi istediğiniz yere sürükleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Поділіть будь-яку панель або прокручуйте колонки вбік. Перетягніть вкладку будь-куди, щоб перемістити її."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chia bất kỳ khung nào, hoặc cuộn ngang qua các cột. Kéo một tab đến bất kỳ đâu để di chuyển nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "拆分任意面板，或横向滚动浏览各列。将标签页拖到任意位置即可移动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "分割任意面板，或橫向捲動瀏覽各欄。將標籤頁拖到任何位置即可移動。"
          }
        }
      }
    },
    "onboarding.tour.screens.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep several full layouts in one workspace, like tmux windows. They stay hidden until you show the switcher."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "tmux のウインドウのように、1 つのワークスペースに複数のレイアウトを保持できます。スイッチャーを表示するまで隠れています。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "احتفظ بعدة تخطيطات كاملة في مساحة عمل واحدة، مثل نوافذ tmux. تبقى مخفية حتى تُظهر المبدِّل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Držite nekoliko cijelih rasporeda u jednom radnom prostoru, kao tmux prozore. Skriveni su dok ne prikažete birač."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hav flere komplette layouts i ét arbejdsområde, ligesom tmux-vinduer. De forbliver skjulte, indtil du viser vælgeren."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Behalte mehrere vollständige Layouts in einem Workspace, wie tmux-Fenster. Sie bleiben verborgen, bis du den Umschalter einblendest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mantén varios diseños completos en un espacio de trabajo, como las ventanas de tmux. Permanecen ocultos hasta que muestras el selector."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gardez plusieurs dispositions complètes dans un espace de travail, comme les fenêtres tmux. Elles restent masquées jusqu’à ce que vous affichiez le sélecteur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tieni più layout completi in uno spazio di lavoro, come le finestre di tmux. Restano nascosti finché non mostri il selettore."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "រក្សាប្លង់ពេញលេញច្រើននៅក្នុងកន្លែងធ្វើការតែមួយ ដូចវិនដូ tmux។ ពួកវានៅលាក់ រហូតដល់អ្នកបង្ហាញកម្មវិធីប្ដូរ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "tmux 윈도우처럼 하나의 작업 공간에 여러 전체 레이아웃을 유지합니다. 전환기를 표시할 때까지 숨겨져 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ha flere komplette oppsett i ett arbeidsområde, som tmux-vinduer. De holdes skjult til du viser velgeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trzymaj kilka pełnych układów w jednym obszarze roboczym, jak okna tmux. Pozostają ukryte, dopóki nie pokażesz przełącznika."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mantenha vários layouts completos em um espaço de trabalho, como as janelas do tmux. Eles ficam ocultos até você mostrar o seletor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Держите несколько полных раскладок в одном рабочем пространстве, как окна tmux. Они скрыты, пока вы не откроете переключатель."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เก็บเลย์เอาต์เต็มหลายแบบไว้ในพื้นที่ทำงานเดียว เหมือนหน้าต่าง tmux โดยจะซ่อนอยู่จนกว่าคุณจะแสดงตัวสลับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tek bir çalışma alanında tmux pencereleri gibi birkaç tam yerleşim tutun. Değiştiriciyi gösterene kadar gizli kalırlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Тримайте кілька повних макетів в одному робочому просторі, як вікна tmux. Вони приховані, доки ви не відкриєте перемикач."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Giữ nhiều bố cục đầy đủ trong một không gian làm việc, giống như cửa sổ tmux. Chúng được ẩn cho đến khi bạn hiển thị bộ chuyển đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "像 tmux 窗口一样，在一个工作区中保留多个完整布局。它们会保持隐藏，直到你显示切换器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "像 tmux 視窗一樣，在一個工作區中保留多個完整佈局。它們會保持隱藏，直到你顯示切換器。"
          }
        }
      }
    },
