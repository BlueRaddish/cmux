    "onboarding.import.cookiesNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-ins come from each browser's cookies. macOS asks once per browser before cmux can read its key; Deny skips only that browser's sign-ins."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تأتي تسجيلات الدخول من ملفات تعريف الارتباط لكل متصفح. يسأل macOS مرة واحدة لكل متصفح قبل أن يتمكن cmux من قراءة مفتاحه؛ ويؤدي \"رفض\" إلى تخطي تسجيلات الدخول لذلك المتصفح فقط."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prijave dolaze iz kolačića svakog preglednika. macOS pita jednom po pregledniku prije nego cmux može pročitati njegov ključ; Odbij preskače samo prijave tog preglednika."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Logins kommer fra hver browsers cookies. macOS spørger én gang pr. browser, før cmux kan læse dens nøgle; Afvis springer kun den browsers logins over."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anmeldungen stammen aus den Cookies jedes Browsers. macOS fragt einmal pro Browser, bevor cmux dessen Schlüssel lesen kann; „Ablehnen“ überspringt nur die Anmeldungen dieses Browsers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los inicios de sesión vienen de las cookies de cada navegador. macOS pregunta una vez por navegador antes de que cmux pueda leer su clave; Denegar omite solo los inicios de sesión de ese navegador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les connexions proviennent des cookies de chaque navigateur. macOS demande une fois par navigateur avant que cmux puisse lire sa clé ; Refuser ignore uniquement les connexions de ce navigateur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gli accessi provengono dai cookie di ciascun browser. macOS chiede una volta per browser prima che cmux possa leggerne la chiave; Rifiuta salta solo gli accessi di quel browser."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "サインイン情報は各ブラウザの Cookie から取得されます。cmux がキーを読み取る前に、macOS がブラウザごとに一度確認します。「拒否」を選ぶと、そのブラウザのサインイン情報だけがスキップされます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការចូលគណនីមកពីខូគីរបស់កម្មវិធីរុករកនីមួយៗ។ macOS សួរម្ដងសម្រាប់កម្មវិធីរុករកនីមួយៗ មុនពេល cmux អាចអានកូនសោរបស់វា។ បដិសេធ រំលងតែការចូលគណនីរបស់កម្មវិធីរុករកនោះប៉ុណ្ណោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "로그인 정보는 각 브라우저의 쿠키에서 가져옵니다. cmux가 키를 읽기 전에 macOS가 브라우저마다 한 번씩 묻습니다. 거부를 선택하면 해당 브라우저의 로그인 정보만 건너뜁니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pålogginger hentes fra hver nettlesers informasjonskapsler. macOS spør én gang per nettleser før cmux kan lese nøkkelen; Avslå hopper bare over den nettleserens pålogginger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Logowania pochodzą z plików cookie każdej przeglądarki. macOS pyta raz dla każdej przeglądarki, zanim cmux odczyta jej klucz; Odmów pomija tylko logowania tej przeglądarki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os logins vêm dos cookies de cada navegador. O macOS pergunta uma vez por navegador antes que o cmux possa ler a chave; Negar ignora apenas os logins desse navegador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Входы берутся из файлов cookie каждого браузера. macOS один раз спрашивает для каждого браузера, прежде чем cmux сможет прочитать его ключ; «Запретить» пропускает входы только этого браузера."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การลงชื่อเข้ามาจากคุกกี้ของแต่ละเบราว์เซอร์ macOS จะถามหนึ่งครั้งต่อเบราว์เซอร์ก่อนที่ cmux จะอ่านกุญแจได้ ปฏิเสธ จะข้ามเฉพาะการลงชื่อเข้าของเบราว์เซอร์นั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Oturum açma bilgileri her tarayıcının çerezlerinden gelir. cmux bir tarayıcının anahtarını okumadan önce macOS o tarayıcı için bir kez sorar; Reddet yalnızca o tarayıcının oturum açma bilgilerini atlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Входи беруться з файлів cookie кожного браузера. macOS один раз запитує для кожного браузера, перш ніж cmux зможе прочитати його ключ; «Заборонити» пропускає входи лише цього браузера."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Thông tin đăng nhập lấy từ cookie của mỗi trình duyệt. macOS hỏi một lần cho mỗi trình duyệt trước khi cmux có thể đọc khóa; Từ chối chỉ bỏ qua thông tin đăng nhập của trình duyệt đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "登录信息来自各浏览器的 Cookie。在 cmux 读取某个浏览器的密钥前，macOS 会针对每个浏览器询问一次；选择“拒绝”只会跳过该浏览器的登录信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "登入資訊來自各瀏覽器的 Cookie。在 cmux 讀取瀏覽器的金鑰前，macOS 會針對每個瀏覽器詢問一次；選擇「拒絕」只會略過該瀏覽器的登入資訊。"
          }
        }
      }
    },
    "onboarding.import.extensions.detail2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install All opens each store page in the background. Click Add to Chrome on each; the list checks them off."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يفتح \"تثبيت الكل\" كل صفحة متجر في الخلفية. انقر على Add to Chrome في كل صفحة؛ وستضع القائمة علامة عليها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Instaliraj sve otvara svaku stranicu trgovine u pozadini. Kliknite Add to Chrome na svakoj; lista ih označava."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Installer alle åbner hver butiksside i baggrunden. Klik på Add to Chrome på hver; listen krydser dem af."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„Alle installieren“ öffnet jede Store-Seite im Hintergrund. Klicke jeweils auf „Add to Chrome“; die Liste hakt sie ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Instalar todo abre cada página de la tienda en segundo plano. Haz clic en Add to Chrome en cada una; la lista las irá marcando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tout installer ouvre chaque page de la boutique en arrière-plan. Cliquez sur Add to Chrome sur chacune ; la liste les coche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Installa tutto apre ogni pagina dello store in background. Fai clic su Add to Chrome in ciascuna; l’elenco le spunta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「すべてインストール」を押すと、各ストアページがバックグラウンドで開きます。それぞれで「Add to Chrome」をクリックすると、リストにチェックが付きます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ដំឡើងទាំងអស់ បើកទំព័រហាងនីមួយៗនៅផ្ទៃខាងក្រោយ។ ចុច Add to Chrome នៅលើទំព័រនីមួយៗ បញ្ជីនឹងធីកពួកវា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "모두 설치를 누르면 각 스토어 페이지가 백그라운드에서 열립니다. 각 페이지에서 Add to Chrome을 클릭하면 목록에 체크 표시됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Installer alle åpner hver butikkside i bakgrunnen. Klikk på Add to Chrome på hver; listen huker dem av."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zainstaluj wszystkie otwiera każdą stronę sklepu w tle. Kliknij Add to Chrome na każdej; lista je odhaczy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Instalar Tudo abre cada página da loja em segundo plano. Clique em Add to Chrome em cada uma; a lista vai marcando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«Установить все» открывает каждую страницу магазина в фоне. Нажмите Add to Chrome на каждой; список отметит их."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ติดตั้งทั้งหมด จะเปิดหน้าร้านค้าแต่ละหน้าในเบื้องหลัง คลิก Add to Chrome ในแต่ละหน้า รายการจะทำเครื่องหมายให้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tümünü Yükle her mağaza sayfasını arka planda açar. Her birinde Add to Chrome’u tıklayın; liste onları işaretler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«Інсталювати всі» відкриває кожну сторінку магазину у фоні. Натисніть Add to Chrome на кожній; список позначить їх."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cài đặt tất cả sẽ mở từng trang cửa hàng trong nền. Bấm Add to Chrome trên từng trang; danh sách sẽ đánh dấu chúng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“全部安装”会在后台打开每个商店页面。在每个页面上点按 Add to Chrome，列表会逐一勾选。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「全部安裝」會在背景打開每個商店頁面。在每個頁面上按一下 Add to Chrome，列表會逐一勾選。"
          }
        }
      }
    },
