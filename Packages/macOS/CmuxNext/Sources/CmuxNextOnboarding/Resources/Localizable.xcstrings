    "onboarding.import.passwordsNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Passwords stay where they are: export them from the browser or the Passwords app into your password manager."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تبقى كلمات السر في مكانها: صدّرها من المتصفح أو من تطبيق كلمات السر إلى مدير كلمات السر لديك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lozinke ostaju gdje jesu: izvezite ih iz preglednika ili aplikacije Lozinke u svoj upravitelj lozinki."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Adgangskoder bliver, hvor de er: Eksporter dem fra browseren eller appen Adgangskoder til din adgangskodeadministrator."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Passwörter bleiben, wo sie sind: Exportiere sie aus dem Browser oder der App „Passwörter“ in deinen Passwortmanager."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las contraseñas se quedan donde están: expórtalas desde el navegador o la app Contraseñas a tu gestor de contraseñas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les mots de passe restent où ils sont : exportez-les depuis le navigateur ou l’app Mots de passe vers votre gestionnaire de mots de passe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le password restano dove sono: esportale dal browser o dall’app Password nel tuo gestore di password."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "パスワードはそのまま残ります。ブラウザまたは“パスワード”アプリから書き出して、パスワードマネージャに読み込んでください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ពាក្យសម្ងាត់នៅដដែល៖ នាំចេញពួកវាពីកម្មវិធីរុករក ឬកម្មវិធីពាក្យសម្ងាត់ ទៅកម្មវិធីគ្រប់គ្រងពាក្យសម្ងាត់របស់អ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "암호는 그대로 유지됩니다. 브라우저나 암호 앱에서 내보내어 암호 관리자로 옮기십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Passord blir der de er: Eksporter dem fra nettleseren eller Passord-appen til passordbehandleren din."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hasła zostają tam, gdzie są: wyeksportuj je z przeglądarki lub aplikacji Hasła do swojego menedżera haseł."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As senhas ficam onde estão: exporte-as do navegador ou do app Senhas para o seu gerenciador de senhas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Пароли остаются на месте: экспортируйте их из браузера или приложения «Пароли» в свой менеджер паролей."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "รหัสผ่านจะยังอยู่ที่เดิม: ส่งออกจากเบราว์เซอร์หรือแอปรหัสผ่านไปยังตัวจัดการรหัสผ่านของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Parolalar olduğu yerde kalır: Onları tarayıcıdan veya Parolalar uygulamasından parola yöneticinize aktarın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Паролі залишаються на місці: експортуйте їх із браузера або програми «Паролі» у свій менеджер паролів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mật khẩu vẫn ở nguyên chỗ: xuất chúng từ trình duyệt hoặc ứng dụng Mật khẩu vào trình quản lý mật khẩu của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "密码保持原位：请从浏览器或“密码” App 中导出，再导入你的密码管理器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "密碼會保留在原處：請從瀏覽器或「密碼」App 輸出，再匯入你的密碼管理工具。"
          }
        }
      }
    },
    "onboarding.import.subtitle2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bookmarks, history, open tabs, sign-ins and extensions from every browser on this Mac. Nothing leaves this Mac."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "الإشارات المرجعية والسجل وعلامات التبويب المفتوحة وتسجيلات الدخول والإضافات من كل متصفح على هذا الـ Mac. لا شيء يغادر هذا الـ Mac."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Oznake, historija, otvorene kartice, prijave i proširenja iz svih preglednika na ovom Macu. Ništa ne napušta ovaj Mac."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bogmærker, historik, åbne faner, logins og udvidelser fra alle browsere på denne Mac. Intet forlader denne Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lesezeichen, Verlauf, offene Tabs, Anmeldungen und Erweiterungen aus jedem Browser auf diesem Mac. Nichts verlässt diesen Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Marcadores, historial, pestañas abiertas, inicios de sesión y extensiones de todos los navegadores de este Mac. Nada sale de este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Signets, historique, onglets ouverts, connexions et extensions de chaque navigateur de ce Mac. Rien ne quitte ce Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Preferiti, cronologia, schede aperte, accessi ed estensioni da ogni browser su questo Mac. Nulla lascia questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この Mac 上のすべてのブラウザから、ブックマーク、履歴、開いているタブ、サインイン情報、拡張機能を読み込みます。データがこの Mac の外に出ることはありません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ចំណាំ ប្រវត្តិ ថេបដែលបើក ការចូលគណនី និងផ្នែកបន្ថែម ពីគ្រប់កម្មវិធីរុករកនៅលើ Mac នេះ។ គ្មានអ្វីចាកចេញពី Mac នេះទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 Mac에 있는 모든 브라우저의 책갈피, 방문 기록, 열린 탭, 로그인 정보 및 확장 프로그램을 가져옵니다. 데이터는 이 Mac 밖으로 나가지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bokmerker, logg, åpne faner, pålogginger og utvidelser fra alle nettlesere på denne Macen. Ingenting forlater denne Macen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zakładki, historia, otwarte karty, logowania i rozszerzenia ze wszystkich przeglądarek na tym Macu. Nic nie opuszcza tego Maca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Favoritos, histórico, abas abertas, logins e extensões de todos os navegadores deste Mac. Nada sai deste Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Закладки, история, открытые вкладки, входы и расширения из всех браузеров на этом Mac. Ничего не покидает этот Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "บุ๊กมาร์ก ประวัติ แถบที่เปิดอยู่ การลงชื่อเข้า และส่วนขยายจากทุกเบราว์เซอร์บน Mac เครื่องนี้ ไม่มีข้อมูลใดออกจาก Mac เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu Mac’teki her tarayıcıdan yer işaretleri, geçmiş, açık sekmeler, oturum açma bilgileri ve uzantılar. Hiçbir şey bu Mac’ten çıkmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Закладки, історія, відкриті вкладки, входи та розширення з усіх браузерів на цьому Mac. Ніщо не залишає цей Mac."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dấu trang, lịch sử, tab đang mở, thông tin đăng nhập và tiện ích từ mọi trình duyệt trên máy Mac này. Không có gì rời khỏi máy Mac này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "导入这台 Mac 上所有浏览器的书签、历史记录、打开的标签页、登录信息和扩展。所有数据都不会离开这台 Mac。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "匯入這部 Mac 上所有瀏覽器的書籤、瀏覽記錄、打開的標籤頁、登入資訊和延伸功能。所有資料都不會離開這部 Mac。"
          }
        }
      }
    },
