    "onboarding.keyboard.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start from the style you know. Every shortcut stays editable."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ابدأ بالنمط الذي تعرفه. يظل كل اختصار قابلاً للتعديل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Počnite sa stilom koji poznajete. Svaka prečica ostaje izmjenjiva."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Start med den stil, du kender. Alle genveje kan stadig redigeres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Starte mit dem Stil, den du kennst. Jeder Kurzbefehl bleibt bearbeitbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Empieza con el estilo que conoces. Todos los atajos siguen siendo editables."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Partez du style que vous connaissez. Chaque raccourci reste modifiable."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Parti dallo stile che conosci. Ogni scorciatoia resta modificabile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "慣れたスタイルから始めましょう。すべてのショートカットは後から編集できます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ចាប់ផ្ដើមពីរចនាប័ទ្មដែលអ្នកស្គាល់។ ផ្លូវកាត់នីមួយៗនៅតែអាចកែបាន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "익숙한 스타일로 시작하십시오. 모든 단축키는 언제든지 편집할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Start med stilen du kjenner. Alle snarveier kan fortsatt redigeres."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zacznij od znanego stylu. Każdy skrót można edytować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Comece pelo estilo que você conhece. Todos os atalhos continuam editáveis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Начните со знакомого стиля. Любое сочетание клавиш можно изменить."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เริ่มจากสไตล์ที่คุณคุ้นเคย ปุ่มลัดทุกปุ่มยังแก้ไขได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bildiğiniz stille başlayın. Her kestirme düzenlenebilir kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Почніть зі знайомого стилю. Кожне скорочення можна редагувати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bắt đầu với phong cách quen thuộc. Mọi phím tắt vẫn chỉnh sửa được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "从你熟悉的风格开始。每个快捷键都可以随时编辑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "從你熟悉的風格開始。每個快速鍵都可隨時編輯。"
          }
        }
      }
    },
