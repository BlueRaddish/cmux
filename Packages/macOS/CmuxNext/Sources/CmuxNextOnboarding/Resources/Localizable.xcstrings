    "onboarding.welcome.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A terminal and browser for agents, built on Ghostty. Two minutes and it feels like home."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "وحدة طرفية ومتصفح للوكلاء، مبنيان على Ghostty. دقيقتان وستشعر وكأنك في بيتك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Terminal i preglednik za agente, izgrađen na osnovi Ghostty. Dvije minute i osjećat ćete se kao kod kuće."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En terminal og browser til agenter, bygget på Ghostty. To minutter, og du føler dig hjemme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein Terminal und Browser für Agents, basierend auf Ghostty. Zwei Minuten, und du fühlst dich wie zu Hause."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un terminal y navegador para agentes, basado en Ghostty. En dos minutos te sentirás como en casa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un terminal et un navigateur pour les agents, basé sur Ghostty. Deux minutes et vous êtes chez vous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un terminale e un browser per agenti, basato su Ghostty. Due minuti e ti sentirai a casa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "エージェントのためのターミナルとブラウザ。Ghostty をベースに構築されています。2 分で使い慣れた環境になります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ស្ថានីយ និងកម្មវិធីរុករកសម្រាប់ភ្នាក់ងារ ដែលបង្កើតលើ Ghostty។ ពីរនាទី ហើយវានឹងមានអារម្មណ៍ដូចនៅផ្ទះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ghostty 기반의 에이전트용 터미널 및 브라우저입니다. 2분이면 익숙해집니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En terminal og nettleser for agenter, bygd på Ghostty. To minutter, så føles det som hjemme."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Terminal i przeglądarka dla agentów, zbudowane na Ghostty. Dwie minuty i poczujesz się jak w domu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um terminal e navegador para agentes, feito com base no Ghostty. Dois minutos e você vai se sentir em casa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Терминал и браузер для агентов на основе Ghostty. Пара минут, и Вы почувствуете себя как дома."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เทอร์มินัลและเบราว์เซอร์สำหรับเอเจนต์ สร้างบน Ghostty ใช้เวลาสองนาทีก็รู้สึกเหมือนอยู่บ้าน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ajanlar için Ghostty tabanlı bir terminal ve tarayıcı. İki dakikada kendinizi evinizde hissedeceksiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Термінал і браузер для агентів на основі Ghostty. Дві хвилини, і ви почуватиметеся як удома."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Terminal và trình duyệt cho tác tử, xây dựng trên Ghostty. Chỉ hai phút là bạn thấy như ở nhà."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "基于 Ghostty 构建、为智能体打造的终端和浏览器。只需两分钟，就能得心应手。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "以 Ghostty 打造、為代理程式設計的終端機和瀏覽器。只要兩分鐘，就能得心應手。"
          }
        }
      }
    },
    "onboarding.welcome.keysHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Return continues. Escape skips the rest. Reopen this any time from the command palette or Settings."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Return للمتابعة. Escape لتخطي الباقي. أعد فتح هذا في أي وقت من لوحة الأوامر أو الإعدادات."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Return nastavlja. Escape preskače ostalo. Ponovo otvorite ovo bilo kada iz palete komandi ili Postavki."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Retur fortsætter. Escape springer resten over. Åbn dette igen når som helst fra kommandopaletten eller Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zeilenschalter fährt fort. Escape überspringt den Rest. Öffne dies jederzeit erneut über die Befehlspalette oder die Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Retorno para continuar. Escape omite el resto. Vuelve a abrir esto cuando quieras desde la paleta de comandos o Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Retour pour continuer. Échap pour ignorer le reste. Rouvrez cet écran à tout moment depuis la palette de commandes ou les Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A capo per continuare. Esc salta il resto. Riapri questa schermata in qualsiasi momento dalla palette dei comandi o da Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Return キーで続行、Escape キーで残りをスキップします。コマンドパレットまたは設定からいつでも再表示できます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Return ដើម្បីបន្ត។ Escape រំលងផ្នែកដែលនៅសល់។ បើកវាឡើងវិញបានគ្រប់ពេលពីផ្ទាំងពាក្យបញ្ជា ឬការកំណត់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Return 키를 누르면 계속하고 Escape 키를 누르면 나머지를 건너뜁니다. 명령 팔레트나 설정에서 언제든지 다시 열 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Retur fortsetter. Escape hopper over resten. Åpne dette igjen når som helst fra kommandopaletten eller Innstillinger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Return kontynuuje. Escape pomija resztę. Otwórz to ponownie w dowolnej chwili z palety poleceń lub Ustawień."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Return continua. Esc pula o resto. Reabra isto a qualquer momento pela paleta de comandos ou pelos Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Return продолжает. Escape пропускает остальное. Откройте это снова в любое время из палитры команд или Настроек."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Return เพื่อดำเนินการต่อ Escape เพื่อข้ามส่วนที่เหลือ เปิดหน้านี้อีกครั้งได้ทุกเมื่อจากชุดคำสั่งหรือการตั้งค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Return devam eder. Escape gerisini atlar. Bunu istediğiniz zaman komut paletinden veya Ayarlar’dan yeniden açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Return продовжує. Escape пропускає решту. Відкрийте це знову будь-коли з палітри команд або Параметрів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Return để tiếp tục. Escape để bỏ qua phần còn lại. Mở lại bất cứ lúc nào từ bảng lệnh hoặc Cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "按 Return 键继续，按 Escape 键跳过其余步骤。随时可从命令面板或设置中重新打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "按 Return 鍵繼續，按 Escape 鍵略過其餘步驟。隨時可從命令面板或設定中重新打開。"
          }
        }
      }
    },
