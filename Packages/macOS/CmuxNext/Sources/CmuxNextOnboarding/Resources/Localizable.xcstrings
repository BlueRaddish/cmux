  "strings": {
    "onboarding.browser.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make cmux Your Browser"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux をブラウザにする"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اجعل cmux متصفحك"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Neka cmux bude vaš preglednik"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gør cmux til din browser"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux als Browser verwenden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usa cmux como navegador"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Faire de cmux votre navigateur"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usa cmux come browser"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ប្រើ cmux ជាកម្មវិធីរុករករបស់អ្នក"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux를 브라우저로 사용"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gjør cmux til nettleseren din"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ustaw cmux jako przeglądarkę"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Use o cmux como navegador"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сделайте cmux своим браузером"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ใช้ cmux เป็นเบราว์เซอร์ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux'ı Tarayıcınız Yapın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Зробіть cmux своїм браузером"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đặt cmux làm trình duyệt"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "将 cmux 设为浏览器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "將 cmux 設為瀏覽器"
          }
        }
      }
    },
    "onboarding.browser.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Links from any app open as tabs in your current cmux window, next to your terminals."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "どのアプリのリンクも、現在の cmux ウインドウのターミナルの隣にタブとして開きます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تُفتح الروابط من أي تطبيق كعلامات تبويب في نافذة cmux الحالية، بجوار الطرفيات."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Linkovi iz bilo koje aplikacije otvaraju se kao kartice u trenutnom cmux prozoru, pored vaših terminala."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Links fra alle apps åbnes som faner i dit nuværende cmux-vindue ved siden af dine terminaler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Links aus jeder App werden als Tabs im aktuellen cmux-Fenster geöffnet, neben deinen Terminals."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los enlaces de cualquier app se abren como pestañas en tu ventana actual de cmux, junto a tus terminales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les liens de n’importe quelle app s’ouvrent en onglets dans votre fenêtre cmux actuelle, à côté de vos terminaux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I link di qualsiasi app si aprono come schede nella finestra di cmux corrente, accanto ai tuoi terminali."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "តំណពីកម្មវិធីណាមួយនឹងបើកជាផ្ទាំងក្នុងវិនដូ cmux បច្ចុប្បន្នរបស់អ្នក នៅក្បែរទែមីណាល់របស់អ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "모든 앱의 링크가 현재 cmux 윈도우의 터미널 옆에 탭으로 열립니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lenker fra alle apper åpnes som faner i det nåværende cmux-vinduet, ved siden av terminalene dine."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Łącza z dowolnej aplikacji otwierają się jako karty w bieżącym oknie cmux, obok terminali."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Links de qualquer app abrem como abas na janela atual do cmux, ao lado dos seus terminais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ссылки из любого приложения открываются как вкладки в текущем окне cmux рядом с терминалами."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ลิงก์จากทุกแอปจะเปิดเป็นแถบในหน้าต่าง cmux ปัจจุบัน ข้างเทอร์มินัลของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Herhangi bir uygulamadaki bağlantılar, geçerli cmux pencerenizde terminallerinizin yanında sekme olarak açılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Посилання з будь-якої програми відкриваються як вкладки в поточному вікні cmux поруч із терміналами."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Liên kết từ mọi ứng dụng sẽ mở thành tab trong cửa sổ cmux hiện tại, cạnh các terminal của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "来自任何 App 的链接都会在当前 cmux 窗口中以标签页打开，就在你的终端旁边。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "來自任何 App 的連結都會在目前 cmux 視窗中以標籤頁打開，就在你的終端機旁邊。"
          }
        }
      }
    },
