    "onboarding.keyboard.preset.browser.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘T opens a web tab, ⌥⌘ arrows switch tabs."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⌘T يفتح علامة تبويب ويب، و⌥⌘ مع الأسهم للتبديل بين علامات التبويب."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⌘T otvara web karticu, ⌥⌘ i strelice mijenjaju kartice."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⌘T åbner en webfane, ⌥⌘ og pile skifter fane."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⌘T öffnet einen Web-Tab, ⌥⌘ und Pfeiltasten wechseln Tabs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⌘T abre una pestaña web, ⌥⌘ y flechas cambian de pestaña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⌘T ouvre un onglet web, ⌥⌘ + flèches changent d’onglet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⌘T apre una scheda web, ⌥⌘ e frecce cambiano scheda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⌘T で Web タブを開き、⌥⌘ と矢印キーでタブを切り替えます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⌘T បើកថេបវេប ⌥⌘ និងព្រួញប្ដូរថេប។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⌘T로 웹 탭을 열고 ⌥⌘ 및 화살표로 탭을 전환합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⌘T åpner en nettfane, ⌥⌘ og piler bytter fane."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⌘T otwiera kartę www, ⌥⌘ i strzałki przełączają karty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⌘T abre uma aba web, ⌥⌘ e setas alternam abas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⌘T открывает веб-вкладку, ⌥⌘ и стрелки переключают вкладки."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⌘T เปิดแถบเว็บ ⌥⌘ กับลูกศรสลับแถบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⌘T bir web sekmesi açar, ⌥⌘ ve oklar sekmeler arasında geçiş yapar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⌘T відкриває вебвкладку, ⌥⌘ і стрілки перемикають вкладки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⌘T mở tab web, ⌥⌘ và phím mũi tên để chuyển tab."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⌘T 打开网页标签页，⌥⌘ 加方向键切换标签页。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⌘T 打開網頁標籤頁，⌥⌘ 加方向鍵切換標籤頁。"
          }
        }
      }
    },
