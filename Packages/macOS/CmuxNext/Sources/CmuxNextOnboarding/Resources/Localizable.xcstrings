    "onboarding.appearance.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything applies as you pick it. Skip puts it all back."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يتم تطبيق كل شيء فور اختياره. يؤدي \"تخطي\" إلى إرجاع كل شيء."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sve se primjenjuje čim odaberete. Preskoči sve vraća."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alt anvendes, mens du vælger. Spring over sætter alt tilbage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alles wird sofort bei der Auswahl angewendet. „Überspringen“ setzt alles zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Todo se aplica al elegirlo. Omitir lo restablece todo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tout s’applique dès que vous choisissez. Ignorer rétablit tout."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tutto si applica appena scegli. Salta ripristina tutto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "選択するとすぐに適用されます。「スキップ」を押すとすべて元に戻ります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "អ្វីៗទាំងអស់អនុវត្តភ្លាមៗពេលអ្នកជ្រើសរើស។ រំលង នឹងស្ដារអ្វីៗទាំងអស់វិញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "선택하는 즉시 적용됩니다. 건너뛰기를 누르면 모두 되돌립니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alt tas i bruk mens du velger. Hopp over tilbakestiller alt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wszystko działa od razu po wyborze. Pomiń przywraca wszystko."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tudo é aplicado conforme você escolhe. Pular desfaz tudo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Все применяется сразу при выборе. «Пропустить» вернет все обратно."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ทุกอย่างจะมีผลทันทีที่คุณเลือก ข้าม จะคืนค่าทั้งหมด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seçtiğiniz anda her şey uygulanır. Atla her şeyi geri alır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Усе застосовується одразу під час вибору. «Пропустити» поверне все назад."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mọi lựa chọn được áp dụng ngay. Bỏ qua sẽ khôi phục tất cả."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "所选内容会立即生效。点按“跳过”可全部还原。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "選取後立即套用。按「略過」可全部還原。"
          }
        }
      }
    },
